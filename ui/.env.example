# Leave blank for the combined production deployment: API requests use the same origin.
# For next dev on port 3000, use http://localhost:8000 instead.
NEXT_PUBLIC_BACKEND_BASE_URL=

# Optional social providers. Leave public IDs empty to hide their buttons.
# These must match the backend credentials and registered redirect URLs.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=accounts/googleCallback
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_FACEBOOK_REDIRECT_URI=accounts/fbCallback
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_REDIRECT_URI=accounts/msCallback
