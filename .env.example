# Copy to .env for a new template instance. Never overwrite an existing .env.
SITE_NAME=Full-stack Template
SECRET_KEY=development-only-change-before-deployment
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

# Select sqlite or postgresql. SQLite ignores DATABASE_URL.
DATABASE_ENGINE=sqlite
# Required only when DATABASE_ENGINE=postgresql.
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000 http://127.0.0.1:8000
ACCESS_TOKEN_TIME=30
REFRESH_TOKEN_TIME=1440

# Account endpoint rate limits. All attempts count, including invalid submissions.
AUTH_LOGIN_RATE=10/min
AUTH_SIGNUP_RATE=5/hour
AUTH_PASSWORD_RESET_RATE=5/hour
AUTH_PASSWORD_RESET_EMAIL_RATE=3/hour
AUTH_VERIFICATION_RESEND_RATE=5/hour
AUTH_VERIFICATION_RESEND_EMAIL_RATE=3/hour
AUTH_RESET_CONFIRM_RATE=10/min
AUTH_EMAIL_VERIFY_RATE=20/min
# 0 ignores X-Forwarded-For. Set the actual trusted proxy count on your host.
AUTH_TRUSTED_PROXY_COUNT=0

# Public URL of the combined deployment, used in email and social callbacks.
FRONTEND_BASE_URL=http://localhost:8000

# Development email links print in the terminal. For SMTP, set EMAIL_BACKEND to
# django.core.mail.backends.smtp.EmailBackend and configure the fields below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Optional Cloudinary credentials for profile pictures uploaded through admin.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional social login credentials. Matching public IDs belong in ui/.env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=accounts/googleCallback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=accounts/fbCallback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=accounts/msCallback
